using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Windows.Forms;

namespace BloatwareRemover
{
    public partial class Form1 : Form
    {
        private readonly Dictionary<string, string> _applications = new Dictionary<string, string>
        {
            { "3D Viewer", "Microsoft.Microsoft3DViewer" },
            { "Alarms & Clock", "Microsoft.WindowsAlarms" },
            { "Feedback Hub", "Microsoft.WindowsFeedbackHub" },
            { "Get Help", "Microsoft.GetHelp" },
            { "Groove Music", "Microsoft.ZuneMusic" },
            { "Microsoft Solitaire Collection", "Microsoft.MicrosoftSolitaireCollection" },
            { "News & Interests", "Microsoft.BingNews" },
            { "Paint 3D", "Microsoft.MSPaint" },
            { "Skype", "Microsoft.SkypeApp" },
            { "Snip & Sketch", "Microsoft.ScreenSketch" },
            { "Sticky Notes", "Microsoft.MicrosoftStickyNotes" },
            { "Tips", "Microsoft.Getstarted" },
            { "Your Phone", "Microsoft.YourPhone" }
        };

        public Form1()
        {
            InitializeComponent();
            lblInstructions.Text = "Please select the applications to remove:";
            foreach (string application in _applications.Keys)
            {
                lstApplications.Items.Add(application);
            }
        }

        private void btnRemove_Click(object sender, EventArgs e)
        {
            List<string> removeApplications = new List<string>();
            foreach (string selectedItem in lstApplications.SelectedItems)
            {
                removeApplications.Add(selectedItem);
            }

            if (removeApplications.Count == 0)
            {
                MessageBox.Show("No applications selected for removal.", "Info", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            DialogResult confirmResult = MessageBox.Show(
                "The following applications will be removed:\n\n" + string.Join(", ", removeApplications) + "\n\nDo you want to continue?",
                "Confirm",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            );

            if (confirmResult != DialogResult.Yes)
            {
                return;
            }

            int removed = 0;
            int failed = 0;
            foreach (string removeApplication in removeApplications)
            {
                try
                {
                    string packageName = _applications[removeApplication];
                    ProcessStartInfo startInfo = new ProcessStartInfo
                    {
                        FileName = "powershell.exe",
                        Arguments = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$ErrorActionPreference='Stop'; $packages=Get-AppxPackage -Name '" + packageName + "'; if(-not $packages){ exit 2 }; $packages | Remove-AppxPackage -ErrorAction Stop\"",
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };

                    using (Process process = Process.Start(startInfo))
                    {
                        if (process == null)
                        {
                            failed++;
                            continue;
                        }

                        process.WaitForExit();
                        if (process.ExitCode == 0)
                        {
                            removed++;
                        }
                        else
                        {
                            failed++;
                        }
                    }
                }
                catch (Exception ex)
                {
                    failed++;
                    MessageBox.Show("Could not remove " + removeApplication + ":\n\n" + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }

            MessageBox.Show(
                "Removal finished.\n\nRemoved: " + removed + "\nFailed or not installed: " + failed,
                failed == 0 ? "Success" : "Completed with errors",
                MessageBoxButtons.OK,
                failed == 0 ? MessageBoxIcon.Information : MessageBoxIcon.Warning
            );
        }

        private void btnKeepAll_Click(object sender, EventArgs e)
        {
            lstApplications.ClearSelected();
        }
    }
}
